<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Moberg.DbConfig.Provider.SqlServer</PackageId>
    <Title>Moberg.DbConfig (SQL Server provider)</Title>
    <Description>SQL Server provider for DbConfig: EF Core SqlServer wiring, migrations, and unique-constraint detection. Call b.UseSqlServer(connectionString) inside AddDbConfig.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- Microsoft.Data.SqlClient 6.1.x (via EF Core SqlServer) pulls System.Security.Cryptography.Pkcs
         9.0.x, affected by GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (fixed in 10.0.13). No SqlClient
         release depends on a patched version yet, so pin it directly. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DbConfig.EntityFrameworkCore\DbConfig.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbConfig.Tests" />
  </ItemGroup>

</Project>
