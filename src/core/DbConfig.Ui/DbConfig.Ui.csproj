<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Moberg.DbConfig.Ui</PackageId>
    <Title>Moberg.DbConfig (UI)</Title>
    <Description>Embedded React + Tailwind admin UI for DbConfig. Mounts via MapDbConfigUi at any route prefix. Talks exclusively to MapDbConfigHttp endpoints — no direct DB access. Tenant-aware, dark mode, hierarchical tree view, demo mode.</Description>
  </PropertyGroup>

  <!-- Rebuild React UI before embedding. Vite writes directly into this project's dist/
       folder (configured in ui/vite.config.ts → outDir). Auto-bootstraps node_modules so
       a fresh checkout + dotnet build does not require a separate npm install step. -->
  <Target Name="InstallUI"
          BeforeTargets="BuildUI"
          Condition="'$(BuildingInsideVisualStudio)' != 'true' And Exists('$(ProjectDir)../../../ui/package.json') And !Exists('$(ProjectDir)../../../ui/node_modules')">
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)../../../ui" />
  </Target>

  <Target Name="BuildUI"
          BeforeTargets="BeforeBuild"
          Condition="'$(BuildingInsideVisualStudio)' != 'true' And Exists('$(ProjectDir)../../../ui/package.json')">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)../../../ui" />
  </Target>

  <!-- Embed dist/**/* dynamically AFTER BuildUI has populated it. Declaring the items
       as a static ItemGroup at project-load time evaluates the glob BEFORE BuildUI runs,
       so on a fresh checkout the .nupkg ships without the UI bundle. Adding the items
       inside a target keeps the glob expansion deferred until after the React build,
       and is gated on dist/ existing so VS builds (where BuildUI is skipped) still
       embed a previously-built bundle when one is present. -->
  <Target Name="IncludeBuiltUiAsEmbeddedResources"
          AfterTargets="BuildUI"
          BeforeTargets="BeforeBuild"
          Condition="Exists('dist')">
    <ItemGroup>
      <EmbeddedResource Include="dist/**/*" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbConfig.Core\DbConfig.Core.csproj" />
    <ProjectReference Include="..\DbConfig.Http\DbConfig.Http.csproj" />
  </ItemGroup>

</Project>
